# Copy this file to .env and fill it in. .env is git-ignored; never commit real values.

# Required. The SEC asks for a contact email in the User-Agent header of every request to sec.gov.
SEC_CONTACT_EMAIL=

# Local Postgres started by `make db-up`.
DATABASE_URL=postgresql://filingcheck:filingcheck@localhost:5432/filingcheck

# Week 2 onward: model and embedding providers. Leave commented out until needed.
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Week 2 onward: tracing.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
