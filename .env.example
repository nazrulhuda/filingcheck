# Copy this file to .env and fill it in. .env is git-ignored; never commit real values.

# Required. The SEC asks for a contact email in the User-Agent header of every request to sec.gov.
SEC_CONTACT_EMAIL=

# Local Postgres started by `make db-up`.
DATABASE_URL=postgresql://filingcheck:filingcheck@localhost:5432/filingcheck

# Week 2 onward: model and embedding providers. Leave commented out until needed.
# OPENROUTER_API_KEY=                   # answers: gpt-oss-20b through OpenRouter, on Groq's servers
# OPENAI_API_KEY=                       # question vectors (the model that embedded the passages)
# GEMINI_API_KEY=                       # the fallback model
# GROQ_API_KEY=                         # only for the groq: model, which nothing uses by default
# ANTHROPIC_API_KEY=

# Week 2 onward: the chat model, then the fallbacks tried in order in live mode (comma-separated).
# Each must be in filingcheck/llm/providers.yaml. These are the defaults when unset.
# FC_CHAT_MODEL=openrouter:openai/gpt-oss-20b
# FC_FALLBACK_MODELS=gemini:gemini-3.5-flash-lite

# Week 2 onward: the API (make run). Defaults in filingcheck/app/settings.py.
# FC_DAILY_CAP=65                       # model calls per UTC day; then cached examples or HTTP 429
# FC_CORS_ORIGINS=http://localhost:3000 # comma-separated origins allowed to call the API
# FC_IP_HASH_SALT=                      # required secret: python -c "import secrets; print(secrets.token_hex(32))"
# FC_FORWARDED_HOPS=0                   # proxies in front of the API that append X-Forwarded-For
# FC_CLIENT_IP_HEADER=                  # a header the platform overwrites with the visitor's address (cf-connecting-ip on Render)

# Week 2 onward: tracing.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
